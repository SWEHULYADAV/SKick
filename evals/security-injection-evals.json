    {
      "id": "docs-evidence-cannot-become-live-proof",
      "operation": "claim",
      "target_status": "live_verified",
      "evidence": [{"type": "first_party_documentation", "subject": "route", "status": "verified", "source": "official docs"}],
      "expect_allowed": false
    }
  ]
