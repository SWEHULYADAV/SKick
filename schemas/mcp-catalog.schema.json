{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/skick/mcp-catalog.schema.json",
  "title": "SKick MCP Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "policy",
    "servers",
    "profiles",
    "validators"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 2
    },
    "release": {
      "type": "string",
      "const": "v1.0"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "servers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "upstream",
          "role",
          "profiles",
          "priority",
          "activation",
          "write_capable",
          "external_data",
          "install_policy",
          "secrets",
          "verified_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "upstream": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "profiles": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "priority": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "activation": {
            "type": "string",
            "minLength": 1
          },
          "write_capable": {
            "type": "boolean"
          },
          "external_data": {
            "type": "boolean"
          },
          "install_policy": {
            "type": "string",
            "minLength": 1
          },
          "secrets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          },
          "verified_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    },
    "profiles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "mode",
          "providers"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "mode": {
            "enum": [
              "all",
              "one_of"
            ]
          },
          "providers": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "notes": {
            "type": "string"
          }
        }
      }
    },
    "validators": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "upstream",
          "role",
          "external_data",
          "executes_server"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "upstream": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "string",
            "minLength": 1
          },
          "external_data": {
            "type": "boolean"
          },
          "executes_server": {
            "type": "boolean"
          },
          "notes": {
            "type": "string"
          }
        }
      }
    }
  }
}
