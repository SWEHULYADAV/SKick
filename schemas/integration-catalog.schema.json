{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://openai.local/skick/integration-catalog.schema.json",
  "title": "SKick Specialist Integration Catalog",
  "type": "object",
  "required": [
    "schema_version",
    "release",
    "policy",
    "integrations"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "release": {
      "type": "string",
      "const": "v1.1"
    },
    "policy": {
      "type": "string",
      "minLength": 1
    },
    "integrations": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "kind",
          "upstream",
          "role",
          "decision",
          "license",
          "activation",
          "verified_at"
        ],
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
          },
          "kind": {
            "type": "string",
            "minLength": 1
          },
          "upstream": {
            "type": "string",
            "minLength": 1
          },
          "role": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "decision": {
            "type": "string",
            "minLength": 1
          },
          "license": {
            "type": "string",
            "minLength": 1
          },
          "activation": {
            "type": "string",
            "minLength": 1
          },
          "verified_at": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        }
      }
    }
  }
}
