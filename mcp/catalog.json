  "validators": [
    {
      "id": "mcp-inspector",
      "upstream": "https://github.com/modelcontextprotocol/inspector",
      "role": "protocol/capability qualification in an isolated environment",
      "external_data": false,
      "executes_server": true,
      "notes": "Unknown stdio servers must be source/config reviewed and sandboxed before Inspector launches them."
    },
    {
      "id": "snyk-agent-scan",
      "upstream": "https://github.com/snyk/agent-scan",
      "role": "optional independent skill/MCP security scan",
      "external_data": true,
      "executes_server": true,
      "notes": "MCP config scanning can execute configured stdio commands and may share component metadata with Snyk; use sandbox/consent."
    },
    {
      "id": "skick-static-scan",
      "upstream": "local:scripts/scan_skill_package.py",
      "role": "deterministic local skill/plugin package preflight",
      "external_data": false,
      "executes_server": false,
      "notes": "Heuristic findings require human/agent review; no network or external execution."
    }
